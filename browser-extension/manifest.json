{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.9.16",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "downloads.open",
    "offscreen",
    "downloads.ui",
    "storage",
    "scripting",
    "tabs",
    "cookies",
    "webRequest",
    "proxy",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rank.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://*.arkoselabs.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-relay.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://*.arkoselabs.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://*.arkoselabs.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
